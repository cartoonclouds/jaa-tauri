{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@modules/*": ["src/modules/*"],
      "@shared/*": ["src/shared/*"],
      "@infra/*": ["src/infrastructure/*"],
      "@testUtils/*": ["tests/unit/shared/utils/*"]
    },
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "tests/**/*.tsx",
    "tests/**/*.vue"
  ]
}
