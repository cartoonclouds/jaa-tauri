{
  "name": "apply-flow",
  "description": "A desktop application for managing and tracking job applications.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "dev:tauri": "nuxt dev --host 127.0.0.1 --port 3000 --strictPort",
    "dev:clear": "node scripts/dev-clear.mjs",
    "generate": "nuxt generate",
    "tauri": "tauri",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint --fix .",
    "typecheck": "npm run typecheck:app && npm run typecheck:node && npm run typecheck:test",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:normalize-constants": "tsx --tsconfig tsconfig.seed.json src-tauri/factories/normalize-constants.ts",
    "db:seed": "tsx --tsconfig tsconfig.seed.json src-tauri/factories/seed.ts",
    "db:seed:production": "tsx --tsconfig tsconfig.seed.json src-tauri/factories/seed.ts --mode=production"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@nuxt/hints": "1.1.1",
    "@nuxt/icon": "2.2.2",
    "@nuxtjs/device": "4.0.0",
    "@primeuix/themes": "2.0.3",
    "@primevue/forms": "4.5.5",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "4.3.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-sql": "2.4.0",
    "@tauri-apps/plugin-store": "2.4.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@vee-validate/nuxt": "4.15.1",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "dompurify": "^3.4.7",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "marked": "^18.0.4",
    "nuxt": "4.4.5",
    "nuxt-security": "2.6.0",
    "primevue": "4.5.5",
    "quill": "^2.0.3",
    "sortablejs": "^1.15.7",
    "tailwindcss": "4.3.0",
    "turndown": "^7.2.4",
    "vee-validate": "4.15.1",
    "vue": "3.5.34",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@iconify-json/heroicons": "1.2.3",
    "@nuxt/test-utils": "4.0.3",
    "@tauri-apps/cli": "2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "25.8.0",
    "@types/sortablejs": "^1.15.9",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "@vue/test-utils": "2.4.10",
    "better-sqlite3": "^12.10.0",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "10.9.1",
    "globals": "17.6.0",
    "happy-dom": "20.9.0",
    "prettier": "3.8.3",
    "tsx": "^4.22.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.16",
    "vitest": "4.1.6",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.9"
  }
}
