{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for all platforms",
  "windows": [
    "main",
    "onboarding-dialog"
  ],
  "domains": [
    "http://127.0.0.1",
    "http://localhost"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-enabled",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-write",
    "fs:allow-copy-file",
    "fs:allow-read-file", 
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:read-all",
    "fs:write-all",
    "store:default",
    "window-state:default",
    "updater:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "shell:default",
    "log:default"
  ]
}
