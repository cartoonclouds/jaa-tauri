{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for all platforms",
  "windows": [
    "main"
  ],
  "domains": [
    "http://127.0.0.1",
    "http://localhost"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "store:default",
    "window-state:default",
    "updater:default",
    "notification:default",
    "shell:default",
    "log:default"
  ]
}
